/* pages/canteen/index.wxss */
.page-header {
  padding: 20rpx 0;
}
.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B35;
}
.page-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.floor-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.floor-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
}
.floor-tab.active {
  background: #FF6B35;
  color: #fff;
  font-weight: bold;
}

.floor-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 10rpx;
}

.stall-list {
  margin-top: 10rpx;
}
.stall-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.stall-emoji {
  width: 90rpx;
  height: 90rpx;
  background: #FFF0E5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-right: 20rpx;
}
.stall-info { flex: 1; }
.stall-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}
.stall-sig {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.stall-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.stall-price {
  text-align: right;
}
.stall-price .price {
  font-size: 36rpx;
}
.stall-price .text-sm {
  display: block;
  margin-top: 4rpx;
}

/* 弹层 */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.popup-card {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 30rpx;
  animation: slideUp 0.3s ease-out;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
.popup-emoji {
  text-align: center;
  font-size: 100rpx;
  margin-bottom: 16rpx;
}
.popup-name {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.popup-sig {
  text-align: center;
  font-size: 26rpx;
  color: #FF6B35;
  margin-bottom: 24rpx;
}
.popup-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.popup-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #4CAF50;
}
.popup-tags {
  display: flex;
  gap: 6rpx;
}
.popup-note {
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #666;
}
.popup-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}
.popup-btn-fav, .popup-btn-close {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}
.popup-btn-fav {
  background: #FFF0E5;
  color: #FF6B35;
}
.popup-btn-fav.faved {
  background: #FF6B35;
  color: #fff;
}
.popup-btn-close {
  background: #f5f5f5;
  color: #666;
}
