/* pages/index/index.wxss */
.header {
  padding: 30rpx 0 20rpx;
  text-align: center;
}
.header-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #FF6B35;
  letter-spacing: 4rpx;
}
.header-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 筛选 Tab（横向滚动，使用 inline-block 避免 flex 撑高） */
.filter-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  white-space: nowrap;
}
.filter-item {
  display: inline-block;
  text-align: center;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.2s;
  margin-right: 6rpx;
}
.filter-item.active {
  background: #FF6B35;
  color: #fff;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.4);
}

/* 推荐卡片 */
.recommend-card {
  background: linear-gradient(135deg, #FF6B35 0%, #FFA500 100%);
  border-radius: 24rpx;
  padding: 50rpx 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
  animation: fadeIn 0.4s ease-out;
}
.recommend-card.rolling {
  animation: shake 0.2s infinite;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes shake {
  0%   { transform: translateX(-4rpx) rotate(-1deg); }
  50%  { transform: translateX(4rpx) rotate(1deg); }
  100% { transform: translateX(-4rpx) rotate(-1deg); }
}
.rec-emoji {
  font-size: 140rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}
.rec-name {
  font-size: 52rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}
.rec-shop {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}
.rec-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.rec-price {
  font-size: 40rpx;
  font-weight: bold;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}
.rec-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
}
.rec-tags .tag {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  border: none;
}
.rec-desc {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 30rpx;
  padding: 0 20rpx;
}

.rec-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 20rpx;
}
.btn-roll {
  background: #fff;
  color: #FF6B35;
  font-size: 32rpx;
  font-weight: bold;
  padding: 18rpx 50rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}
.btn-icon {
  display: inline-block;
  animation: rotate 2s linear infinite;
}
@keyframes rotate {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
.btn-fav {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 36rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.btn-fav.faved {
  background: #fff;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
}
.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

/* 快捷入口 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin: 10rpx 0 20rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #FF6B35;
}
.quick-grid {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.quick-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.quick-emoji {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin: 0 auto 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  color: #fff;
}
.quick-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 快捷入口改为横向滚动 */
.quick-scroll {
  white-space: nowrap;
  margin-bottom: 30rpx;
}
.quick-scroll .quick-card {
  display: inline-block;
  width: 180rpx;
  margin-right: 16rpx;
}
.quick-scroll .quick-card:last-child {
  margin-right: 0;
}

/* 使用提示 */
.tip-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
}
.tip-card .text-sm {
  display: block;
  margin: 6rpx 0;
  color: #999;
}

/* —— 新增按钮样式 —— */
.btn-ate {
  background: #FF9EC4;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 18rpx 30rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 158, 196, 0.4);
}
.btn-jump {
  background: #fff;
  color: #FF6B35;
  font-size: 30rpx;
  font-weight: bold;
  padding: 18rpx 50rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}
