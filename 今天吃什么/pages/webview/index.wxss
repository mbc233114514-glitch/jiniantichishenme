/* pages/webview/index.wxss */
.webview-wrap {
  width: 100%;
  height: 100vh;
}
.webview-empty, .webview-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}
.empty-emoji, .err-emoji {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}
.empty-text { color: #999; }
.err-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.err-desc {
  text-align: center;
  max-width: 560rpx;
  margin: 6rpx 0;
  word-break: break-all;
  color: #999;
}
.err-btn {
  margin-top: 30rpx;
  background: #FF6B35;
  color: #fff;
  padding: 18rpx 50rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}
