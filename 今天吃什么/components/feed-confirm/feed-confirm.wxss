/* components/feed-confirm/feed-confirm.wxss */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.popup {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  animation: popIn 0.25s ease-out;
}
@keyframes popIn {
  from { transform: scale(0.8); opacity: 0; }
  to   { transform: scale(1);   opacity: 1; }
}
.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #FF9EC4;
  text-align: center;
  margin-bottom: 30rpx;
}
.popup-dish {
  display: flex;
  background: #FFF8F3;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.dish-emoji {
  font-size: 70rpx;
  width: 100rpx;
  height: 100rpx;
  background: #FFE4EC;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.dish-info { flex: 1; }
.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}
.dish-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}
.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.dish-tags .tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #FFE4EC;
  color: #FF9EC4;
}

.popup-effect {
  background: #FFF0E5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 30rpx;
}
.effect-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}
.effect-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 6rpx 0;
  color: #333;
}
.effect-val {
  font-weight: bold;
  color: #FF6B35;
}

.popup-actions {
  display: flex;
  gap: 16rpx;
}
.btn-cancel, .btn-confirm {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}
.btn-cancel {
  background: #f5f5f5;
  color: #666;
}
.btn-confirm {
  background: linear-gradient(135deg, #FF6B35 0%, #FF9EC4 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}
