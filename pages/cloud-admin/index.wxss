/* pages/cloud-admin/index.wxss */
.container { padding: 24rpx; }
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.title { font-size: 40rpx; font-weight: bold; color: #FF6B35; }
.status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
}
.status.ok { background: #4CAF50; }
.status.no { background: #999; }

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding: 10rpx 24rpx;
}
.step { padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.step:last-child { border-bottom: none; }
.step-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.step-desc { font-size: 22rpx; color: #999; line-height: 1.6; margin-bottom: 16rpx; }

.btn {
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  padding: 22rpx 0;
  border-radius: 40rpx;
  color: #fff;
}
.btn.primary { background: linear-gradient(135deg, #FF6B35, #FFA500); }
.btn.pink { background: linear-gradient(135deg, #FF9EC4, #FF6B9D); }
.btn.ghost { background: #f5f5f5; color: #666; }

.counts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.counts text {
  font-size: 22rpx;
  background: #FFF0E5;
  color: #FF6B35;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.log-card {
  background: #2b2b2b;
  border-radius: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
}
.log-head { color: #8be9fd; font-size: 24rpx; margin-bottom: 10rpx; }
.log-box { max-height: 400rpx; }
.log-text {
  color: #f8f8f2;
  font-size: 22rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
.tip {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 30rpx;
}
