/* pages/street/index.wxss */
.page-header {
  padding: 20rpx 0 24rpx;
}
.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B35;
}
.page-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.street-list {
  margin-top: 10rpx;
}
.street-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  align-items: flex-start;
}
.street-emoji {
  font-size: 60rpx;
  margin-right: 20rpx;
  width: 90rpx;
  height: 90rpx;
  background: #FFF0E5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.street-info {
  flex: 1;
}
.street-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}
.street-feature {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}
.street-loc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}
.street-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 8rpx;
}
.street-note {
  background: #FFF8E1;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  font-size: 20rpx;
  color: #666;
  margin-top: 6rpx;
}

.want-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFF0E5;
  color: #FF6B35;
  border-radius: 40rpx;
  padding: 16rpx 18rpx;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
}
.want-btn.wanted {
  background: #FF6B35;
  color: #fff;
}
.want-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}
.want-text {
  font-size: 20rpx;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  padding: 20rpx 0 40rpx;
}
